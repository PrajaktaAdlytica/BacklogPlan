# Hostinger Apache/LiteSpeed: serve the compiled SPA, with deep-link support.
Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^\.git(?:/|$) - [F,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static assets must remain 404s, not receive HTML.
  RewriteRule ^(?:assets|intro)/ - [L]
  RewriteCond %{REQUEST_URI} \.[^/]+$
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
